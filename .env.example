OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 留空则使用 OpenAI 官方地址
OPENAI_BASE_URL=

# Vercel 网页授权。Google Cloud 里建「Web 应用」，回调填 https://你的域名/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# 任意长随机字符串，用来保住授权过程
FLASK_SECRET_KEY=
# true 才会真的发信。不填则只演练
LIVE_SEND=false
# Vercel Cron 用来调用 /cron
CRON_SECRET=

# 接上 Vercel KV 之后由网页授权自动写入，一般不用手填
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 注册和登录的验证码从这里发出。Gmail 可用应用专用密码，主机默认 smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 只允许这些邮箱注册和登录，多个用逗号分开。留空则不限制
ALLOWED_EMAILS=
